t available feature engineering functions.\n\n    Shows built-in functions that can be used in feature configs with the\n    'function:' key instead of writing raw Polars expressions.\n\n    Examples:\n\n        dyxgb functions                    # List all functions\n        dyxgb functions -c math            # List only math functions\n        dyxgb functions -f json            # Output as JSON\n        dyxgb functions -f csv > funcs.csv # Export to CSV\n    \"\"\"\n    from dyxgb.transforms.registry import get_categories, list_functions\n\n    if category:\n        valid_categories = get_categories()\n        if category not in valid_categories:\n            _error(f\"Unknown category '{category}'. Valid: {', '.join(sorted(valid_categories))}\")\n            raise typer.Exit(EXIT_USAGE_ERROR)\n\n    funcs = list_functions(category)\n\n    if not funcs:\n        _info(\"No functions found.\")\n        raise typer.Exit(0)\n\n    if output_format == \"json\":\n        import json\n\n        data = [\n            {\n                \"name\": f.name,\n                \"category\": f.category,\n                \"description\": f.description,\n                \"params\": f.params,\n                \"example\": f.example,\n            }\n            for f in funcs\n        ]\n        print(json.dumps(data, indent=2))\n\n    elif output_format == \"csv\":\n        print(\"name,category,description,params,example\")\n        for f in funcs:\n            params_str = \";\".join(f.params) if f.params else \"\"\n            desc = f.description.replace('\"', '\"\"')\n            example = f.example.replace('\"', '\"\"')\n            print(f'\"{f.name}\",\"{f.category}\",\"{desc}\",\"{params_str}\",\"{example}\"')\n\n    else:\n        _print_functions_table(funcs, category)\n\n\ndef _print_functions_table(funcs: list, category: str | None) -> None:\n    \"\"\"Print functions as a Rich table.\"\"\"\n    try:\n        from rich.console import Console\n        from rich.table import Table\n\n        console = Console(stderr=True)\n        title = f\"Feature Functions ({category})\" if category else \"Feature Functions\"\n        table = Table(title=title, show_header=True, header_style=\"bold\")\n\n        table.add_column(\"Function\", style=\"cyan\", no_wrap=True)\n        table.add_column(\"Category\", style=\"green\")\n        table.add_column(\"Description\")\n        table.add_column(\"Params\", style=\"dim\")\n\n        for f in funcs:\n            params_str = \", \".join(f.params) if f.params else \"-\"\n            table.add_row(f.name, f.category, f.description, params_str)\n\n        console.print(table)\n\n    except ImportError:\n        _print_functions_simple(funcs)\n\n\ndef _print_functions_simple(funcs: list) -> None:\n    \"\"\"Print functions in simple format (fallback without Rich).\"\"\"\n    for f in funcs:\n        params = f\", params: {', '.join(f.params)}\" if f.params else \"\"\n        print(f\"{f.name} [{f.category}]: {f.description}{params}\", file=sys.stderr)\n\n\n@app.command()\ndef importance(\n    model: Annotated[\n        str,\n        typer.Option(\"--model\", \"-m\", help=\"Path to model bundle or model.json\"),\n    ] = \"model.dyxgb\",","replace_all":false}},{"tool_name":"Bash","tool_use_id":"toolu_01YHC4STVmvz9YBTQNnwaeWU","tool_input":{"command":"python -m pytest tests/test_registry.py -v","description":"Run registry tests"}}],"uuid":"a85c27e6-01e0-4d75-892a-d179229c9d3b"}
