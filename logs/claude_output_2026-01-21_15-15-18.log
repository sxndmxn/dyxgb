f.example,\n            }\n            for f in funcs\n        ]\n        print(json.dumps(data, indent=2))\n\n    elif output_format == \"csv\":\n        print(\"name,category,description,params,example\")\n        for f in funcs:\n            params_str = \";\".join(f.params) if f.params else \"\"\n            # Escape quotes in description and example\n            desc = f.description.replace('\"', '\"\"')\n            example = f.example.replace('\"', '\"\"')\n            print(f'\"{f.name}\",\"{f.category}\",\"{desc}\",\"{params_str}\",\"{example}\"')\n\n    else:  # table format\n        _print_functions_table(funcs, category)\n\n\ndef _print_functions_table(funcs: list, category: str | None) -> None:\n    \"\"\"Print functions as a Rich table.\"\"\"\n    try:\n        from rich.console import Console\n        from rich.table import Table\n\n        console = Console(stderr=True)\n        title = f\"Feature Functions ({category})\" if category else \"Feature Functions\"\n        table = Table(title=title, show_header=True, header_style=\"bold\")\n\n        table.add_column(\"Function\", style=\"cyan\", no_wrap=True)\n        table.add_column(\"Category\", style=\"green\")\n        table.add_column(\"Description\")\n        table.add_column(\"Params\", style=\"dim\")\n\n        for f in funcs:\n            params_str = \", \".join(f.params) if f.params else \"-\"\n            table.add_row(f.name, f.category, f.description, params_str)\n\n        console.print(table)\n\n    except ImportError:\n        # Fallback without Rich\n        _print_functions_simple(funcs)\n\n\ndef _print_functions_simple(funcs: list) -> None:\n    \"\"\"Print functions in simple format (fallback without Rich).\"\"\"\n    for f in funcs:\n        params = f\", params: {', '.join(f.params)}\" if f.params else \"\"\n        print(f\"{f.name} [{f.category}]: {f.description}{params}\", file=sys.stderr)\n\n\n@app.command()\ndef importance(\n    model: Annotated[\n        str,\n        typer