     print(\"name,category,description,params\")\n        for f in funcs:\n            params = \";\".join(f.params) if f.params else \"\"\n            desc = f.description.replace('\"', '\"\"')\n            print(f'{f.name},{f.category},\"{desc}\",\"{params}\"')\n\n    else:  # table format\n        try:\n            from rich.table import Table\n\n            table = Table(title=\"Feature Engineering Functions\")\n            table.add_column(\"Function\", style=\"cyan\", no_wrap=True)\n            table.add_column(\"Category\", style=\"magenta\")\n            table.add_column(\"Description\", style=\"white\")\n            table.add_column(\"Extra Params\", style=\"yellow\")\n\n            for f in funcs:\n                params = \", \".join(f.params) if f.params else \"-\"\n                table.add_row(f.name, f.category, f.description, params)\n\n            if console:\n                console.print(table)\n            else:\n                _print_functions_simple(funcs)\n        except ImportError:\n            _print_functions_simple(funcs)\n\n\ndef _print_functions_simple(funcs: list) -> None:\n    \"\"\"Print functions as simple text table.\"\"\"\n    stderr_print(f\"{'Function':<15} {'Category':<10} {'Description':<45} {'Params'}\")\n    stderr_print(\"-\" * 85)\n    for f in funcs:\n        params = \", \".join(f.params) if f.params else \"-\"\n        stderr_print(f\"{f.name:<15} {f.category:<10} {f.description:<45} {params}\")\n\n\n@app.command()\ndef importance(\n    model: Annotated[\n        str,\n        typer.Option(\"--model\", \"-m\", help=\"Path to model bundle or model.json\"),\n    ] = \"model.dyxgb\",","replace_all":false}},{"tool_name":"Edit","tool_use_id":"toolu_016WBGDZKaaZAvrCMtFGf1HX","tool_input":{"file_path":"/Users/sandmac/code/dyxgb/src/dyxgb/cli.py","old_string":"@app.command()\ndef importance(\n    model: Annotated[\n        str,\n        typer.Option(\"--model\", \"-m\", help=\"Path to model bundle or model.json\"),\n    ] = \"model.dyxgb\",","new_string":"@app.command()\ndef functions(\n    category: Annotated[\n        str | None,\n        typer.Option(\"--category\", \"-c\", help=\"Filter by category: math, string, date, null\"),\n    ] = None,\n    output_format: Annotated[\n        str,\n        typer.Option(\"--format\", \"-f\", help=\"Output format: table, json, csv\"),\n    ] = \"table\",\n) -> None:\n    \"\"\"List available feature engineering functions.\n\n    Shows all built-in functions that can be used in transform configs\n    without needing to know Polars syntax.\n\n    Examples:\n        dyxgb functions                    # Show all functions as table\n        dyxgb functions --category math    # Show only math functions\n        dyxgb functions --format json      # Output as JSON\n        dyxgb functions --format csv       # Output as CSV\n    \"\"\"\n    from dyxgb.transforms.registry import get_categories, list_functions\n\n    funcs = list_functions(category)\n\n    if not funcs:\n        if category:\n            categories = \", \".join(get_categories())\n            _error(f\"Unknown category '{category}'. Available: {categories}\")\n            raise typer.Exit(EXIT_USAGE_ERROR)\n        _error(\"No functions available\")\n        raise typer.Exit(EXIT_RUNTIME_ERROR)\n\n    if output_format == \"json\":\n        import json\n\n        data = [\n            {\n                \"name\": f.name,\n                \"description\": f.description,\n                \"category\": f.category,\n                \"params\": f.params,\n                \"example\": f.example,\n            }\n            for f in funcs\n        ]\n        print(json.dumps(data, indent=2))\n\n    elif output_format == \"csv\":\n        print(\"name,category,description,params\")\n        for f in funcs:\n            params = \";\".join(f.params) if f.params else \"\"\n            desc = f.description.replace('\"', '\"\"')\n            print(f'{f.name},{f.category},\"{desc}\",\"{params}\"')\n\n    else:  # table (default)\n        _print_functions_table(funcs, category)\n\n\ndef _print_functions_table(funcs: list, category: str | None) -> None:\n    \"\"\"Print functions as a Rich table to stderr.\"\"\"\n    try:\n        from rich.table import Table\n\n        title = f\"Feature Functions ({category})\" if category else \"Feature Functions\"\n        table = Table(title=title, show_header=True, header_style=\"bold cyan\")\n        table.add_column(\"Function\", style=\"green\")\n        table.add_column(\"Category\", style=\"yellow\")\n        table.add_column(\"Description\")\n        table.add_column(\"Extra Params\", style=\"dim\")\n\n        for f in funcs:\n            params = \", \".join(f.params) if f.params else \"-\"\n            table.add_row(f.name, f.category, f.description, params)\n\n        if console:\n            console.print(table)\n        else:\n            _print_functions_simple(funcs)\n\n    except ImportError:\n        _print_functions_simple(funcs)\n\n\ndef _print_functions_simple(funcs: list) -> None:\n    \"\"\"Print functions as plain text when Rich is not available.\"\"\"\n    stderr_print(\"\\nAvailable Functions:\")\n    stderr_print(\"-\" * 60)\n    for f in funcs:\n        params = f\", params: {', '.join(f.params)}\" if f.params else \"\"\n        stderr_print(f\"  {f.name} ({f.category}): {f.description}{params}\")\n    stderr_print(\"\")\n\n\n@app.command()\ndef importance(\n    model: Annotated[\n        str,\n        typer.Option(\"--model\", \"-m\", help=\"Path to model bundle or model.json\"),\n    ] = \"model.dyxgb\",","replace_all":false}},{"tool_name":"Bash","tool_use_id":"toolu_015WtnoJinRLQtAkxNzeFfzT","tool_input":{"command":"python -m pytest tests/test_registry.py -v 2>&1","timeout":120000,"description":"Run registry tests"}},{"tool_name":"Bash","tool_use_id":"toolu_01WrEi6ZsRzb5o7y9i54niSx","tool_input":{"command":"python -m pytest tests/test_registry.py -v 2>&1","timeout":120000,"description":"Run registry tests"}},{"tool_name":"Bash","tool_use_id":"toolu_01SK4esEcxpfTaxboDWaGN9v","tool_input":{"command":"python -m pytest tests/test_registry.py -v","timeout":120000,"description":"Run registry tests to verify the function registry implementation"}},{"tool_name":"Bash","tool_use_id":"toolu_01KvEob5rHeRUEHCqfYyuBAc","tool_input":{"command":"python -c \"from dyxgb.transforms.registry import list_functions; print([f.name for f in list_functions()])\"","description":"Verify registry module imports correctly"}}],"uuid":"743b73ca-a646-4dbc-94b4-e69d43667b33"}
