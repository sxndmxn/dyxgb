\"-m\", help=\"Path to model bundle or model.json\"),\n    ] = \"model.dyxgb\",","new_string":"@app.command()\ndef functions(\n    category: Annotated[\n        str | None,\n        typer.Option(\"--category\", \"-c\", help=\"Filter by category: math, string, date, null\"),\n    ] = None,\n    output_format: Annotated[\n        str,\n        typer.Option(\"--format\", \"-f\", help=\"Output format: table, json, csv\"),\n    ] = \"table\",\n) -> None:\n    \"\"\"List available feature engineering functions.\n\n    Shows all built-in functions that can be used in config files\n    without needing to know Polars syntax.\n\n    Examples:\n\n        # Show all functions in a table\n        dyxgb functions\n\n        # Filter by category\n        dyxgb functions --category math\n\n        # Output as JSON\n        dyxgb functions --format json\n    \"\"\"\n    import json\n\n    from dyxgb.transforms.registry import get_categories, list_functions\n\n    funcs = list_functions(category=category)\n\n    if not funcs:\n        _warning(f\"No functions found for category: {category}\")\n        _info(f\"Available categories: {', '.join(get_categories())}\")\n        raise typer.Exit(EXIT_USAGE_ERROR)\n\n    if output_format == \"json\":\n        data = [\n            {\n                \"name\": f.name,\n                \"category\": f.category,\n                \"description\": f.description,\n                \"params\": f.params,\n            }\n            for f in funcs\n        ]\n        print(json.dumps(data, indent=2))\n\n    elif output_format == \"csv\":\n        print(\"name,category,description,params\")\n        for f in funcs:\n            params = \";\".join(f.params) if f.params else \"\"\n            desc = f.description.replace('\"', '\"\"')\n            print(f'{f.name},{f.category},\"{desc}\",\"{params}\"')\n\n    else:  # table format\n        try:\n            from rich.table import Table\n\n            table = Table(title=\"Feature Engineering Functions\